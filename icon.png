(() => {
  const c = document.createElement('canvas');
  c.width = 512; c.height = 512;
  const x = c.getContext('2d');
  x.fillStyle = '#062319';
  x.fillRect(0, 0, 512, 512);
  x.strokeStyle = '#D4AF37';
  x.lineWidth = 22;
  x.beginPath();
  x.moveTo(256, 85); x.lineTo(410, 205); x.lineTo(256, 430); x.lineTo(102, 205);
  x.closePath(); x.stroke();
  x.beginPath();
  x.moveTo(102, 205); x.lineTo(410, 205);
  x.moveTo(175, 85); x.lineTo(256, 205); x.lineTo(337, 85);
  x.stroke();
  const a = document.createElement('a');
  a.download = 'icon.png';
  a.href = c.toDataURL('image/png');
  a.click();
})();
